@page "/Items/Category/{categoryName:regex(^(одежда|электроника|мебель)$)}"
@model Baraholka.Pages.Items.CategoryModel
@{
    ViewData["Title"] = $"Категория: {Model.CategoryName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-capitalize">Категория: @Model.CategoryName</h3>
    <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">Все категории</a>
</div>

@if (Model.Items.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" asp-append-version="true" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary">@item.Category</span>
                            @if (item.IsBooked)
                            {
                                <span class="badge bg-danger">Забронирован</span>
                            }
                            else
                            {
                                <span class="badge bg-success">В наличии</span>
                            }
                        </div>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted small text-truncate">@item.Description</p>
                        <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-primary">@item.Price.ToString("N0") ₽</span>
                            <a asp-page="/Items/Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center py-4">
        В этой категории пока нет товаров.
    </div>
}
