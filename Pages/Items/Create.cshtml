@page
@model Baraholka.Pages.Items.CreateModel
@{
    ViewData["Title"] = "Выставить на продажу";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm p-4">
            <h3 class="fw-bold mb-4">Выставить товар на продажу</h3>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Item.Title" class="form-label"></label>
                    <input asp-for="Item.Title" class="form-control" />
                    <span asp-validation-for="Item.Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.Category" class="form-label"></label>
                    <select asp-for="Item.Category" asp-items="Model.Categories" class="form-select"></select>
                    <span asp-validation-for="Item.Category" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.Price" class="form-label"></label>
                    <input asp-for="Item.Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Item.Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <textarea asp-for="Item.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Item.Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Фотография (до 2 МБ)</label>
                    <input asp-for="Image" type="file" accept="image/*" class="form-control" />
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <div class="mb-3">
                    <label asp-for="Item.SellerName" class="form-label"></label>
                    <input asp-for="Item.SellerName" class="form-control" />
                    <span asp-validation-for="Item.SellerName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Item.SellerPhone" class="form-label"></label>
                    <input asp-for="Item.SellerPhone" class="form-control" />
                    <span asp-validation-for="Item.SellerPhone" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a asp-page="/Index" class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-warning fw-bold">Опубликовать</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
