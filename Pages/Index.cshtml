@page
@model IndexModel
@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Поиск по названию..." />
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <input type="hidden" name="Category" value="@Model.Category" />
            }
            <button type="submit" class="btn btn-primary">Найти</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a asp-page="/Index" asp-route-category="@Model.Category" class="btn btn-outline-secondary">Сброс</a>
            }
        </form>
    </div>
    <div class="col-md-6 d-flex justify-content-md-end gap-2 align-items-center">
        <a asp-page="/Index" asp-route-search="@Model.Search"
           class="btn btn-sm @(string.IsNullOrEmpty(Model.Category) ? "btn-dark" : "btn-outline-secondary")">Все</a>
        <a asp-page="/Index" asp-route-category="одежда" asp-route-search="@Model.Search"
           class="btn btn-sm @(Model.Category == "одежда" ? "btn-dark" : "btn-outline-secondary")">Одежда</a>
        <a asp-page="/Index" asp-route-category="электроника" asp-route-search="@Model.Search"
           class="btn btn-sm @(Model.Category == "электроника" ? "btn-dark" : "btn-outline-secondary")">Электроника</a>
        <a asp-page="/Index" asp-route-category="мебель" asp-route-search="@Model.Search"
           class="btn btn-sm @(Model.Category == "мебель" ? "btn-dark" : "btn-outline-secondary")">Мебель</a>
    </div>
</div>

@if (Model.Items.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" asp-append-version="true" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary">@item.Category</span>
                            @if (item.IsBooked)
                            {
                                <span class="badge bg-danger">Забронирован</span>
                            }
                            else
                            {
                                <span class="badge bg-success">В наличии</span>
                            }
                        </div>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted small text-truncate">@item.Description</p>
                        <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-primary">@item.Price.ToString("N0") ₽</span>
                            <a asp-page="/Items/Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center py-4">
        Объявлений не найдено.
    </div>
}
