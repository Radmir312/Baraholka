<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Барахолка</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">Барахолка</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Все товары</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Items/Category" asp-route-categoryName="одежда">Одежда</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Items/Category" asp-route-categoryName="электроника">Электроника</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Items/Category" asp-route-categoryName="мебель">Мебель</a>
                        </li>
                    </ul>
                    <a class="btn btn-warning fw-semibold" asp-page="/Items/Create">Выставить на продажу</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-center text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year Барахолка
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>